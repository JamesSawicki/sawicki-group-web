---
import "../styles/global.css";
import Header from "../components/Header.astro";
import { agent, brokerage, site } from "../lib/site.config";

interface Props {
  title: string;
  description?: string;
  jsonLd?: object;
  canonical?: string;
}

const {
  title,
  description = "Twin Cities real estate expert serving Minneapolis, Saint Paul, and surrounding communities.",
  jsonLd,
  canonical,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | {site.name}</title>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="bg-white text-stone-800 font-sans antialiased">
    <Header />

    <!-- PAGE CONTENT -->
    <main>
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="border-t border-stone-200 mt-24">
      <div class="max-w-6xl mx-auto px-6 py-12 grid grid-cols-1 sm:grid-cols-3 gap-8 text-sm text-stone-500">
        <div>
          <div class="font-semibold text-stone-900 mb-3">{site.name}</div>
          <div>{brokerage.name}</div>
          <div>{brokerage.serviceArea}</div>
        </div>
        <div>
          <div class="font-semibold text-stone-900 mb-3">Navigate</div>
          <div class="flex flex-col">
            <a href="/listings" class="py-1.5 hover:text-stone-900 transition-colors">
              Listings
            </a>
            <a href="/blog" class="py-1.5 hover:text-stone-900 transition-colors">
              Market Updates
            </a>
            <a href="/about" class="py-1.5 hover:text-stone-900 transition-colors">
              About
            </a>
            <a href="/contact" class="py-1.5 hover:text-stone-900 transition-colors">
              Contact
            </a>
          </div>
        </div>
        <div>
          <div class="font-semibold text-stone-900 mb-3">Legal</div>
          <div class="flex flex-col">
            <a href="/privacy" class="py-1.5 hover:text-stone-900 transition-colors">
              Privacy Policy
            </a>
            <span class="py-1.5">{agent.licenseText}</span>
            <span class="py-1.5">
              © {new Date().getFullYear()} {site.name}
            </span>
            <span class="py-1.5">All rights reserved</span>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
