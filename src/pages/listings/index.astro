---
/**
 * Listings page (/listings): the site's one search experience — a map with listing pins,
 * the matching listings beside/below it, an address/city/ZIP search box and a filter
 * drawer (MapSearch, SearchBox, FilterDrawer). /search and /map redirect here.
 *
 * This file only reads the viewport and filters from the URL and fetches the first page
 * of results on the server, so the map has pins on first paint. Everything after that
 * (panning, zooming, changing filters) is fetched by the MapSearch island.
 */
// ─── Imports ─────────────────────────────────────────────────────────────────
// Mapbox CSS must be imported here in the .astro frontmatter, not inside the React
// island, so Vite bundles it through Astro's build.
import "mapbox-gl/dist/mapbox-gl.css";
import "@mapbox/mapbox-gl-draw/dist/mapbox-gl-draw.css";

import Layout from "../../layouts/Layout.astro";
import MapSearch from "../../components/MapSearch.tsx";
import type { Listing, Page } from "../../types/listing";
import { fetchWithTimeout } from "../../lib/api";
import { applyFiltersToParams, filtersFromParams, MAP_API_SORT } from "../../lib/search-filters";
import { areaFromParams } from "../../lib/search-area";
import { absoluteUrl, breadcrumbList, webPage } from "../../lib/structured-data";
import { listingPath } from "../../lib/listing-utils";

// ─── Config ──────────────────────────────────────────────────────────────────
// Production: Cloud Run sets process.env at runtime; dev: Vite fills import.meta.env.
const apiBase = process.env.PUBLIC_API_BASE_URL || import.meta.env.PUBLIC_API_BASE_URL;
const mapboxToken = process.env.PUBLIC_MAPBOX_TOKEN || import.meta.env.PUBLIC_MAPBOX_TOKEN;
const photoAccountHash =
  process.env.PUBLIC_CF_IMAGES_ACCOUNT_HASH || import.meta.env.PUBLIC_CF_IMAGES_ACCOUNT_HASH;

// ─── Viewport + filters from the URL ─────────────────────────────────────────
// Defaults frame the Twin Cities metro.
const params = Astro.url.searchParams;
const minLat = parseFloat(params.get("minLat") ?? "44.75");
const maxLat = parseFloat(params.get("maxLat") ?? "45.15");
const minLng = parseFloat(params.get("minLng") ?? "-93.90");
const maxLng = parseFloat(params.get("maxLng") ?? "-93.10");
const filters = filtersFromParams(params);
const initialArea = areaFromParams(params); // hand-drawn area, if the URL has one

// ─── Data fetching ───────────────────────────────────────────────────────────
let initialListings: Listing[] = [];
let initialTotal = 0;
try {
  const url = new URL(`${apiBase}/api/listings/search`);
  url.searchParams.set("minLat", String(minLat));
  url.searchParams.set("maxLat", String(maxLat));
  url.searchParams.set("minLng", String(minLng));
  url.searchParams.set("maxLng", String(maxLng));
  applyFiltersToParams(filters, url.searchParams);
  url.searchParams.set("sortBy", MAP_API_SORT); // nearest the center; MapSearch applies the chosen sort
  url.searchParams.set("size", "200");
  // Slim listings (~20 fields): they're embedded in this page's HTML for the map island,
  // and full records made the page ~7 MB.
  url.searchParams.set("view", "summary");

  const res = await fetchWithTimeout(url.toString());
  if (res.ok) {
    const data = (await res.json()) as Page<Listing>;
    initialListings = data.content;
    initialTotal = data.page.totalElements;
  }
} catch {
  // Non-fatal: the map still renders with no pins and refetches client-side as the
  // visitor pans. A hanging API doesn't stall the server response.
}

// ─── Structured data ─────────────────────────────────────────────────────────
// The plain /listings page is the one to index; filtered/moved variants (any query
// string) are kept out of the index but their links are followed. The page lists the
// first homes it shows, so crawlers can reach them from here.
const description =
  "Search Twin Cities homes for sale on an interactive map. Filter by price, beds, baths, property type and more.";
const listingsUrl = absoluteUrl("/listings");
const jsonLd = [
  webPage("SearchResultsPage", "/listings", "Homes for sale", description, {
    breadcrumb: { "@id": `${listingsUrl}#breadcrumb` },
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: initialTotal,
      itemListElement: initialListings.slice(0, 50).map((l, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: absoluteUrl(listingPath(l)),
        name: [l.address, l.city].filter(Boolean).join(", "),
      })),
    },
  }),
  breadcrumbList(listingsUrl, [
    { name: "Home", path: "/" },
    { name: "Listings", path: "/listings" },
  ]),
];
---

<Layout
  title="Search Homes"
  description={description}
  jsonLd={jsonLd}
  noindex={Astro.url.search.length > 0}
>
  <MapSearch
    client:load
    initialListings={initialListings}
    initialTotal={initialTotal}
    initialBbox={{ minLat, maxLat, minLng, maxLng }}
    initialFilters={filters}
    initialArea={initialArea}
    apiBaseUrl={apiBase}
    mapboxToken={mapboxToken}
    photoAccountHash={photoAccountHash}
  />
</Layout>

<style is:global>
  /* The desktop listing preview is our own card inside a Mapbox popup: drop the popup's
     default padding/background so only the card shows, and match the tip to the card. */
  /* Mapbox sets its own font (Helvetica, 12px/20px) inside the map; use the site's. */
  .listing-preview-popup {
    font-family: var(--font-sans);
    line-height: 1.5;
  }
  .listing-preview-popup .mapboxgl-popup-content {
    padding: 0;
    background: transparent;
    box-shadow: none;
  }
  .listing-preview-popup.mapboxgl-popup-anchor-top .mapboxgl-popup-tip,
  .listing-preview-popup.mapboxgl-popup-anchor-top-left .mapboxgl-popup-tip,
  .listing-preview-popup.mapboxgl-popup-anchor-top-right .mapboxgl-popup-tip {
    border-bottom-color: #fff;
  }
  .listing-preview-popup.mapboxgl-popup-anchor-bottom .mapboxgl-popup-tip,
  .listing-preview-popup.mapboxgl-popup-anchor-bottom-left .mapboxgl-popup-tip,
  .listing-preview-popup.mapboxgl-popup-anchor-bottom-right .mapboxgl-popup-tip {
    border-top-color: #fff;
  }
  /* Beside the pin (short maps): "anchor-left" puts the card to the pin's right. */
  .listing-preview-popup.mapboxgl-popup-anchor-left .mapboxgl-popup-tip {
    border-right-color: #fff;
  }
  .listing-preview-popup.mapboxgl-popup-anchor-right .mapboxgl-popup-tip {
    border-left-color: #fff;
  }
</style>
