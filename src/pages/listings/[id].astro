---
/**
 * Listing detail page: /listings/{address-slug}-{id}.
 *
 * This file does routing and data only — resolve the slug, fetch the listing, redirect to
 * the canonical URL, build <head> data — then lays out the section components from
 * src/components/listing/, which own their own display logic.
 */
// ─── Imports ─────────────────────────────────────────────────────────────────
import Layout from "../../layouts/Layout.astro";
import ListingDisclosure from "../../components/ListingDisclosure.astro";
import PhotoGallery from "../../components/PhotoGallery.tsx";
import AmenityScorecard from "../../components/listing/AmenityScorecard.astro";
import BathroomDetail from "../../components/listing/BathroomDetail.astro";
import Breadcrumb from "../../components/listing/Breadcrumb.astro";
import ChecklistSection from "../../components/listing/ChecklistSection.astro";
import ContactSidebar from "../../components/listing/ContactSidebar.astro";
import Description from "../../components/listing/Description.astro";
import Directions from "../../components/listing/Directions.astro";
import ExteriorFeatures from "../../components/listing/ExteriorFeatures.astro";
import FinancialDetails from "../../components/listing/FinancialDetails.astro";
import Hero from "../../components/listing/Hero.astro";
import HoaDetails from "../../components/listing/HoaDetails.astro";
import InteriorFeatures from "../../components/listing/InteriorFeatures.astro";
import ListedBy from "../../components/listing/ListedBy.astro";
import RoomDimensions from "../../components/listing/RoomDimensions.astro";
import Schools from "../../components/listing/Schools.astro";
import SquareFootage from "../../components/listing/SquareFootage.astro";
import Waterfront from "../../components/listing/Waterfront.astro";
import type { Listing } from "../../types/listing";
import {
  formatBathTotal,
  formatPrice,
  formatSqft,
  listingPath,
  parseList,
  parseListingId,
} from "../../lib/listing-utils";
import { parsePhotoIds, parseVirtualTourUrls } from "../../lib/photo-utils";
import { site } from "../../lib/site.config";
import { fetchWithTimeout, serviceUnavailableResponse } from "../../lib/api";

// CSS for React islands is imported here in the .astro frontmatter, not inside the island,
// so Vite resolves and bundles it through Astro's build (same pattern as Mapbox's CSS).
import "yet-another-react-lightbox/styles.css";
import "yet-another-react-lightbox/plugins/thumbnails.css";
import "yet-another-react-lightbox/plugins/counter.css";

// ─── Route param → listing id ────────────────────────────────────────────────
// The file is named [id].astro for historical reasons, but the param is a full SEO slug,
// e.g. "3901-w-50th-st-unit-101-edina-mn-55424-4021". Reading both `slug` and `id` lets
// the file be renamed to [slug].astro later with zero code change. The numeric id is the
// last hyphen-delimited token and is what the API resolves.
const params = Astro.params as Record<string, string | undefined>;
const slugParam = params.slug ?? params.id ?? "";
const listingId = parseListingId(slugParam);
if (listingId == null) {
  // No trailing integer => not a real listing URL. Render the branded 404.
  return Astro.rewrite("/404");
}

// ─── Data fetching ───────────────────────────────────────────────────────────
// Production: Cloud Run sets process.env at runtime. Dev: Vite populates import.meta.env
// from .env.local but NOT process.env. Use both with || so either source works.
const apiBase = process.env.PUBLIC_API_BASE_URL || import.meta.env.PUBLIC_API_BASE_URL;

if (!apiBase) {
  throw new Error(
    "PUBLIC_API_BASE_URL not set in process.env (production) or import.meta.env (dev). " +
      "In dev: confirm sawicki-group-web/.env.local has the line and `npm run dev` was restarted. " +
      "In production: confirm Cloud Run has the env var set via cloudbuild.yaml --update-env-vars.",
  );
}

// Bound the call with a timeout and handle every failure mode:
//   - 404 from the API  → render the branded 404 page (real 404 status)
//   - any other failure → branded 503 (transient) instead of a 500 stack trace or blank page
let listing: Listing;
try {
  const res = await fetchWithTimeout(`${apiBase}/api/listings/${listingId}`);
  if (res.status === 404) {
    return Astro.rewrite("/404");
  }
  if (!res.ok) {
    return serviceUnavailableResponse();
  }
  listing = (await res.json()) as Listing;
} catch {
  // Network error, DNS failure, or timeout (AbortError).
  return serviceUnavailableResponse();
}

// ─── Canonical URL + 301 redirect ────────────────────────────────────────────
// The slug comes from the (mutable) address; the id is stable. A visitor on a bare-id URL
// (/listings/4021) or a stale slug is permanently redirected to the canonical address slug,
// so search ranking consolidates on ONE URL per property. No loop: listingPath() is
// deterministic, so a request already on the canonical path falls through.
const canonicalPath = listingPath(listing);
const canonicalUrl = new URL(canonicalPath, Astro.url.origin).toString();
if (Astro.url.pathname !== canonicalPath) {
  return Astro.redirect(canonicalUrl, 301);
}

// ─── Head data: title, description, JSON-LD ──────────────────────────────────
const priceDisplay = formatPrice(listing.listPrice);
const bathDisplay = formatBathTotal(listing);
const sqftDisplay = formatSqft(listing.sqftTotal);

// IDX: every listing shows its listing brokerage (also used by the "Listed by" card).
const listingBrokerDisplay =
  listing.listOfficeName ?? "Listing brokerage on file with NorthstarMLS";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "RealEstateListing",
  name: `${listing.beds} BD / ${bathDisplay} BA ${listing.style ?? "Home"} — ${listing.address}`,
  description: listing.publicRemarks ?? "",
  url: canonicalUrl,
  // Only assert datePosted when we have it — falling back to "today" would fabricate
  // structured data and make output non-deterministic.
  ...(listing.listDate && { datePosted: listing.listDate }),
  price: listing.listPrice,
  priceCurrency: "USD",
  address: {
    "@type": "PostalAddress",
    streetAddress: listing.address,
    addressLocality: listing.city,
    addressRegion: "MN",
    postalCode: listing.zipCode ?? "",
    addressCountry: "US",
  },
  ...(listing.sqftTotal && {
    floorSize: {
      "@type": "QuantitativeValue",
      value: listing.sqftTotal,
      unitCode: "FTK",
    },
  }),
  ...(listing.beds != null && { numberOfBedrooms: listing.beds }),
  // Always surface the listing brokerage — never imply Sawicki holds the listing.
  broker: {
    "@type": "RealEstateOffice",
    name: listingBrokerDisplay,
  },
};

// ─── Photo gallery data ──────────────────────────────────────────────────────
// Cloudflare delivery URLs are built in the browser from these ids + the account hash.
// The hash is PUBLIC_ on purpose: it's visible in every imagedelivery.net URL anyway.
const cfAccountHash =
  process.env.PUBLIC_CF_IMAGES_ACCOUNT_HASH || import.meta.env.PUBLIC_CF_IMAGES_ACCOUNT_HASH;
const photoIds = parsePhotoIds(listing.photoIds);
const floorPlanIds = parsePhotoIds(listing.floorPlanIds);
const virtualTourUrls = parseVirtualTourUrls(listing.virtualTourUrls);

// ─── Checklist sections ──────────────────────────────────────────────────────
// JSON arrays (or comma-separated text) from MLS, shown as ✓ lists.
const appliancesList = parseList(listing.appliances);
const amenitiesList = parseList(listing.amenities);
---

<Layout
  title={`${listing.address} — ${priceDisplay}`}
  description={`${listing.beds ?? ""} bed, ${bathDisplay} bath ${listing.style ?? "home"} in ${listing.neighborhood ?? listing.city}. ${sqftDisplay} sqft. Listed at ${priceDisplay} by ${site.name}.`}
  jsonLd={jsonLd}
  canonical={canonicalUrl}
>
  <Breadcrumb address={listing.address} />

  {/* ── Photo gallery ── */}
  <div class="max-w-6xl mx-auto px-6 pt-6">
    <PhotoGallery
      client:visible
      photoIds={photoIds}
      floorPlanIds={floorPlanIds}
      virtualTourUrls={virtualTourUrls}
      accountHash={cfAccountHash}
    />
  </div>

  <Hero listing={listing} />

  {/* ── Main content (left) + contact sidebar (right) ── */}
  <div class="max-w-6xl mx-auto px-6 py-10 grid grid-cols-1 lg:grid-cols-5 gap-12">
    <div class="lg:col-span-3 space-y-10">
      <Description listing={listing} />
      <AmenityScorecard listing={listing} />
      <RoomDimensions listing={listing} />
      <SquareFootage listing={listing} />
      <BathroomDetail listing={listing} />
      <InteriorFeatures listing={listing} />
      <ChecklistSection title="Appliances" items={appliancesList} />
      <ExteriorFeatures listing={listing} />
      <ChecklistSection title="Amenities" items={amenitiesList} />
      <Waterfront listing={listing} />
      <HoaDetails listing={listing} />
      <FinancialDetails listing={listing} />
      <Schools listing={listing} />
      <Directions listing={listing} />
      <ListedBy brokerName={listingBrokerDisplay} listDate={listing.listDate} />
    </div>

    <ContactSidebar listingId={listing.id} apiBase={apiBase} />
  </div>

  {/* IDX-required disclosure block: attribution, freshness, disclaimers, fair housing,
      copyright. Always rendered on every listing. */}
  <ListingDisclosure listing={listing} />
</Layout>
