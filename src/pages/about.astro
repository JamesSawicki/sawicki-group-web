---
/**
 * About page: a profile for each team member with a bio in site.config.ts (`team`), in
 * team order. Bios, highlights and headshots are edited there, not here.
 */
// ─── Imports ─────────────────────────────────────────────────────────────────
import Layout from "../layouts/Layout.astro";
import TeamMemberProfile from "../components/brand/TeamMemberProfile.astro";
import { brokerage, primaryContact, site, team } from "../lib/site.config";
import { absoluteUrl, breadcrumbList, ORGANIZATION_ID, webPage } from "../lib/structured-data";

// ─── Derived values ──────────────────────────────────────────────────────────
// Members without a bio yet aren't shown (no empty profiles).
const profiles = team.filter((member) => member.bio?.length);
const description = `Meet ${primaryContact.name}, Twin Cities real estate agent with ${site.name} at ${brokerage.name}.`;
const jsonLd = [
  webPage("AboutPage", "/about", `About ${site.name}`, description, {
    about: { "@id": ORGANIZATION_ID },
    mainEntity: { "@id": ORGANIZATION_ID },
    breadcrumb: { "@id": `${absoluteUrl("/about")}#breadcrumb` },
  }),
  breadcrumbList(absoluteUrl("/about"), [
    { name: "Home", path: "/" },
    { name: "About", path: "/about" },
  ]),
];
---

<Layout title="About" description={description} jsonLd={jsonLd}>
  <section class="max-w-3xl mx-auto px-6 py-20">
    <p class="text-sm font-semibold text-accent uppercase tracking-widest mb-4">About</p>

    {/* ── Profiles ── */}
    <div class="space-y-20">
      {profiles.map((member, i) => (
        <TeamMemberProfile member={member} headingLevel={i === 0 ? "h1" : "h2"} />
      ))}
    </div>

    {/* ── Call to action ── */}
    <div class="mt-12">
      <a href="/contact" class="btn-primary px-6 py-3 rounded-lg font-medium">
        Get in Touch
      </a>
    </div>
  </section>
</Layout>
