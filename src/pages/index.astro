---
/**
 * Home page: a lead generator for the brand (professional, competent, trustworthy). Two
 * equal paths in the hero (search to buy; request a home value to sell), the three
 * markets with their specialists and live for-sale counts, how we work, the team,
 * reviews and track record (each hidden until real content exists), market updates, and
 * a closing form. Content lives in site.config.ts; sections are in components/home/.
 *
 * The live counts come from the API through a 10-minute cache (lib/markets.ts); if the
 * API is down the page still renders, just without the numbers.
 */
// ─── Imports ─────────────────────────────────────────────────────────────────
import Layout from "../layouts/Layout.astro";
import HomeHero from "../components/home/HomeHero.astro";
import ProofBar from "../components/home/ProofBar.astro";
import MarketAreas from "../components/home/MarketAreas.astro";
import HowWeWork from "../components/home/HowWeWork.astro";
import TeamSection from "../components/home/TeamSection.astro";
import Reviews from "../components/home/Reviews.astro";
import MarketUpdates from "../components/home/MarketUpdates.astro";
import TalkToUs from "../components/home/TalkToUs.astro";
import { getCollection } from "astro:content";
import { marketCounts } from "../lib/markets";
import { markets, site } from "../lib/site.config";
import { ORGANIZATION_ID, webPage } from "../lib/structured-data";

// ─── Data fetching ───────────────────────────────────────────────────────────
const apiBaseUrl = process.env.PUBLIC_API_BASE_URL || import.meta.env.PUBLIC_API_BASE_URL;
const [counts, posts] = await Promise.all([marketCounts(), getCollection("blog")]);
const recentPosts = posts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// ─── Derived values ──────────────────────────────────────────────────────────
const description = `Buy or sell in the Twin Cities with ${site.name}: specialists for ${markets.map((m) => m.name).join(", ")}. Search homes or request a home value analysis.`;
const jsonLd = [
  webPage("WebPage", "/", site.name, description, { about: { "@id": ORGANIZATION_ID } }),
];
---

<Layout title="Twin Cities Real Estate" description={description} jsonLd={jsonLd}>
  {/* ── Hero ── */}
  <HomeHero apiBaseUrl={apiBaseUrl} />

  {/* ── Track record ── */}
  <ProofBar />

  {/* ── Markets ── */}
  <MarketAreas counts={counts} />

  {/* ── How we work ── */}
  <HowWeWork />

  {/* ── Team ── */}
  <TeamSection />

  {/* ── Reviews ── */}
  <Reviews />

  {/* ── Market updates ── */}
  <MarketUpdates posts={recentPosts} />

  {/* ── Talk to us ── */}
  <TalkToUs />
</Layout>
