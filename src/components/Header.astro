---
/**
 * Site header: logo, navigation, and the Contact call to action.
 *
 * Below the `md` breakpoint (768px) the links don't fit in one row, so they move into a
 * dropdown opened by a menu button; Contact stays visible beside it as the main action.
 * From `md` up, everything sits in a single row.
 */
// ─── Imports ─────────────────────────────────────────────────────────────────
import { site } from "../lib/site.config";

// ─── Navigation links ────────────────────────────────────────────────────────
// One list feeds both the desktop row and the mobile dropdown, so they can't drift.
const links = [
  { href: "/listings", label: "Listings" },
  { href: "/blog", label: "Market Updates" },
  { href: "/about", label: "About" },
];
---

<header class="border-b border-stone-200 relative">
  <nav class="max-w-6xl mx-auto px-6 py-3 md:py-4 flex items-center justify-between gap-4">
    <a href="/" class="text-xl font-semibold tracking-tight text-stone-900 whitespace-nowrap py-2">
      {site.name}
    </a>

    {/* ── Desktop: single row (md and up) ── */}
    <div class="hidden md:flex items-center gap-8 text-sm text-stone-600">
      {links.map((link) => (
        <a href={link.href} class="py-2 hover:text-stone-900 transition-colors">
          {link.label}
        </a>
      ))}
      <a
        href="/contact"
        class="bg-stone-900 text-white px-4 py-2 rounded-lg hover:bg-stone-700 transition-colors"
      >
        Contact
      </a>
    </div>

    {/* ── Mobile: Contact + menu button (below md) ── */}
    <div class="flex md:hidden items-center gap-2">
      <a
        href="/contact"
        class="bg-stone-900 text-white text-sm px-4 py-2.5 rounded-lg hover:bg-stone-700 transition-colors"
      >
        Contact
      </a>
      <button
        type="button"
        id="nav-toggle"
        class="w-11 h-11 inline-flex items-center justify-center rounded-lg text-stone-700 hover:bg-stone-100"
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="Open menu"
      >
        {/* Hamburger icon; swapped for an X while the menu is open. */}
        <svg
          data-icon="open"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          data-icon="close"
          class="hidden"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </nav>

  {/* ── Mobile dropdown ── */}
  {/* Overlays the page (absolute) rather than pushing it down, and uses full-width 48px rows
      so every link is an easy tap target. */}
  <div
    id="mobile-nav"
    class="hidden md:hidden absolute inset-x-0 top-full z-50 bg-white border-b border-stone-200 shadow-lg"
  >
    <ul class="max-w-6xl mx-auto px-6 py-2">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="flex items-center h-12 text-base text-stone-700 hover:text-stone-900 border-b border-stone-100"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  // Toggle the mobile menu. Closes on Escape and when the viewport grows past md, so it
  // never stays open behind the desktop row.
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-nav");

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle("hidden", !open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      toggle.querySelector('[data-icon="open"]')?.classList.toggle("hidden", open);
      toggle.querySelector('[data-icon="close"]')?.classList.toggle("hidden", !open);
    };

    toggle.addEventListener("click", () => setOpen(menu.classList.contains("hidden")));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
    window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
