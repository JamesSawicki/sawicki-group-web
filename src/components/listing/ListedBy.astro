---
/**
 * "Listed by" attribution card. Always shows the listing brokerage — an IDX display
 * requirement — and never implies The Sawicki Group holds the listing.
 */
interface Props {
  /** Listing brokerage name, or the page's fallback text when it's unknown. */
  brokerName: string;
  /** MLS list date, shown as-is when present. */
  listDate?: string;
}

const { brokerName, listDate } = Astro.props;
---

<div class="bg-stone-50 rounded-xl p-4 text-sm">
  <div class="text-stone-400 text-[10px] uppercase tracking-widest mb-1">Listed by</div>
  <div class="font-semibold text-stone-900">{brokerName}</div>
  {listDate && <div class="text-stone-400 text-xs mt-2">Listed {listDate}</div>}
</div>
