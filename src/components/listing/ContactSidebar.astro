---
/**
 * Right-hand sticky column: the buyer-inquiry call to action and the AI chat island.
 *
 * Every listing gets the same CTA — Jim acts as a buyer's agent on all listings,
 * including ones held by his own brokerage.
 */
// ─── Imports ─────────────────────────────────────────────────────────────────
import ListingChat from "../ListingChat.tsx";
import { agent, site } from "../../lib/site.config";

// ─── Props ───────────────────────────────────────────────────────────────────
interface Props {
  /** Listing id the chat asks about; the API builds the prompt from it server-side. */
  listingId: number;
  /** Base URL of listing-agent-api, passed to the chat island for its POST /api/chat. */
  apiBase: string;
}

const { listingId, apiBase } = Astro.props;

// ─── Derived values ──────────────────────────────────────────────────────────
const ctaTitle = "Interested in this property?";
const ctaBody = `${site.name} can represent you as a buyer's agent to view and make an offer on this property. ${agent.name} typically responds within a few hours.`;
const ctaButton = "Contact us about this listing";
---

<div class="lg:col-span-2">
  <div class="sticky top-8 space-y-6">
    {/* ── Call to action ── */}
    <div class="border border-stone-200 rounded-xl p-6">
      <div class="font-semibold text-stone-900 mb-1">{ctaTitle}</div>
      <p class="text-sm text-stone-500 mb-4">{ctaBody}</p>
      <a
        href="/contact"
        class="inline-block bg-stone-900 text-white text-sm px-5 py-2.5 rounded-lg hover:bg-stone-700 transition-colors"
      >
        {ctaButton}
      </a>
    </div>

    {/* ── AI chat ── */}
    <div>
      <h2 class="text-lg font-semibold text-stone-900 mb-1">Ask About This Property</h2>
      <p class="text-sm text-stone-500 mb-4">
        Get instant answers about features, the neighborhood, financials, or anything else.
      </p>
      <ListingChat client:load listingId={listingId} apiBaseUrl={apiBase} />
    </div>
  </div>
</div>
