---
/**
 * Exterior, construction and lot details (materials, roof, features, lot dimensions,
 * fencing, pool) as a two-column detail list. Rows with no data are skipped.
 */
// ─── Imports ─────────────────────────────────────────────────────────────────
import type { Listing } from "../../types/listing";
import { formatList } from "../../lib/listing-utils";
import DetailRow from "./DetailRow.astro";

// ─── Props ───────────────────────────────────────────────────────────────────
interface Props {
  /** The listing being displayed. */
  listing: Listing;
}

const { listing } = Astro.props;

// ─── Derived values ──────────────────────────────────────────────────────────
// Multi-valued MLS fields arrive as JSON arrays; show them as "A, B, C".
const construction = formatList(listing.constructionMaterials);
const roof = formatList(listing.roof);
---

<div>
  <h2 class="text-lg font-semibold text-stone-900 mb-3">Exterior & Construction</h2>
  <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3 text-sm">
    {construction && <DetailRow label="Construction">{construction}</DetailRow>}
    {roof && <DetailRow label="Roof">{roof}</DetailRow>}
    {listing.exteriorFeatures && (
      <DetailRow label="Exterior Features">{listing.exteriorFeatures}</DetailRow>
    )}
    {listing.lotFeatures && <DetailRow label="Lot Features">{listing.lotFeatures}</DetailRow>}
    {listing.lotDimensions && (
      <DetailRow label="Lot Dimensions" longValue={false}>
        {listing.lotDimensions}
      </DetailRow>
    )}
    {listing.fencing && <DetailRow label="Fencing">{listing.fencing}</DetailRow>}
    {/* MLS sends "None" rather than leaving the field empty. */}
    {listing.pool && listing.pool !== "None" && <DetailRow label="Pool">{listing.pool}</DetailRow>}
  </dl>
</div>
