---
/**
 * Interior systems and features (heating, cooling, fuel, basement, fireplaces, laundry,
 * parking, garage, utilities) as a two-column detail list. Rows with no data are skipped.
 */
// ─── Imports ─────────────────────────────────────────────────────────────────
import type { Listing } from "../../types/listing";
import { formatList, formatSqft, isPositive } from "../../lib/listing-utils";
import DetailRow from "./DetailRow.astro";

// ─── Props ───────────────────────────────────────────────────────────────────
interface Props {
  /** The listing being displayed. */
  listing: Listing;
}

const { listing } = Astro.props;

// ─── Derived values ──────────────────────────────────────────────────────────
// Multi-valued MLS fields arrive as JSON arrays; show them as "A, B, C".
const heating = formatList(listing.heating);
const cooling = formatList(listing.airConditioning);
const basement = formatList(listing.basement);
const parking = formatList(listing.parkingFeatures);
const sewer = formatList(listing.sewer);
const water = formatList(listing.waterSource);
const laundry = formatList(listing.laundryFeatures);
// NorthstarMLS "special search" highlights (main-floor living, laundry location, ...).
const specialFeatures = formatList(listing.specialSearch);

// "2 — Living Room, Gas", or just "2" when the features aren't listed.
const fireplaceDisplay = listing.fireplaceFeatures
  ? `${listing.fireplaces} — ${listing.fireplaceFeatures}`
  : `${listing.fireplaces}`;
---

<div>
  <h2 class="text-lg font-semibold text-stone-900 mb-3">Interior Features</h2>
  <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3 text-sm">
    {heating && <DetailRow label="Heating">{heating}</DetailRow>}
    {cooling && <DetailRow label="Cooling">{cooling}</DetailRow>}
    {listing.fuelType && <DetailRow label="Fuel">{listing.fuelType}</DetailRow>}
    {basement && <DetailRow label="Basement">{basement}</DetailRow>}
    {(listing.fireplaces ?? 0) > 0 && <DetailRow label="Fireplaces">{fireplaceDisplay}</DetailRow>}
    {laundry && <DetailRow label="Laundry">{laundry}</DetailRow>}
    {parking && <DetailRow label="Parking">{parking}</DetailRow>}
    {isPositive(listing.garageSqft) && (
      <DetailRow label="Garage Sqft" longValue={false}>
        {formatSqft(listing.garageSqft)}
      </DetailRow>
    )}
    {listing.electric && <DetailRow label="Electric">{listing.electric}</DetailRow>}
    {sewer && <DetailRow label="Sewer">{sewer}</DetailRow>}
    {water && <DetailRow label="Water">{water}</DetailRow>}
    {specialFeatures && <DetailRow label="Special Features">{specialFeatures}</DetailRow>}
  </dl>
</div>
