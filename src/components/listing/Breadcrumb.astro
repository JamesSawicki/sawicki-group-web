---
/** Breadcrumb trail above the gallery: Home › Listings › {address}. */
interface Props {
  /** Street address shown as the current (last) crumb. */
  address?: string;
}

const { address } = Astro.props;
---

<div class="max-w-6xl mx-auto px-6 pt-8">
  <nav class="text-sm text-stone-400">
    <a href="/" class="hover:text-stone-600 transition-colors">
      Home
    </a>
    <span class="mx-2">›</span>
    <a href="/listings" class="hover:text-stone-600 transition-colors">
      Listings
    </a>
    <span class="mx-2">›</span>
    <span class="text-stone-600">{address}</span>
  </nav>
</div>
