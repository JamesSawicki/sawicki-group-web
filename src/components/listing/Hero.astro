---
/**
 * Listing hero: status/price-reduced badges, address and city line, price (with the
 * struck-through original when reduced), MLS number, the key stats bar, and share buttons.
 */
// ─── Imports ─────────────────────────────────────────────────────────────────
import type { Listing } from "../../types/listing";
import ShareButtons from "../ShareButtons.astro";
import { absoluteUrl } from "../../lib/structured-data";
import {
  displayAddress,
  bathTotal,
  formatBathTotal,
  formatLevels,
  formatLot,
  formatMlsId,
  formatPrice,
  formatSqft,
  hasPriceReduction,
  isPositive,
  listingPath,
  mlsNumber,
  pluralize,
  statusBadgeClasses,
  statusLabel,
} from "../../lib/listing-utils";

// ─── Props ───────────────────────────────────────────────────────────────────
interface Props {
  /** The listing being displayed. */
  listing: Listing;
  /** Absolute URL of the first photo, for Pinterest shares. */
  shareImage?: string;
}

const { listing, shareImage } = Astro.props;

// ─── Derived values ──────────────────────────────────────────────────────────
const priceDisplay = formatPrice(listing.listPrice);
const bathDisplay = formatBathTotal(listing);
const sqftDisplay = formatSqft(listing.sqftTotal);
const lotDisplay = formatLot(listing.lotSqft);
const levelsDisplay = formatLevels(listing.style);
const priceReduced = hasPriceReduction(listing);
const mlsID = formatMlsId(listing.mlsId);
// Share text: "3 bd · 2 ba · $450,000" (no street address when the seller hid it).
const shareSummary = [
  isPositive(listing.beds) ? `${listing.beds} bd` : "",
  bathTotal(listing) > 0 ? `${bathDisplay} ba` : "",
  priceDisplay,
]
  .filter(Boolean)
  .join(" · ");

// "Edina, MN 55436"; empty when the city is unknown.
const cityLine = listing.city
  ? `${listing.city}, MN${listing.zipCode ? ` ${listing.zipCode}` : ""}`
  : "";
---

<div class="max-w-6xl mx-auto px-6 pt-6 pb-8 border-b border-stone-100">
  {/* ── Badges, address, price ── */}
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 mb-2">
        {listing.status && (
          <span class={statusBadgeClasses(listing.status)}>{statusLabel(listing.status)}</span>
        )}
        {priceReduced && (
          <span class="inline-block px-2 py-1 text-xs font-semibold rounded bg-red-100 text-red-700">
            Price Reduced
          </span>
        )}
      </div>
      <h1 class="text-3xl font-semibold text-stone-900">{displayAddress(listing)}</h1>
      <div class="text-stone-500 mt-1">{cityLine}</div>
      {listing.neighborhood && (
        <div class="text-xs text-stone-500 uppercase tracking-widest mt-1">
          {listing.neighborhood}
        </div>
      )}
    </div>
    <div class="text-right shrink-0">
      <div class="text-3xl font-semibold text-stone-900">{priceDisplay}</div>
      {priceReduced && (
        <div class="text-sm text-stone-500 line-through mt-0.5">
          {formatPrice(listing.originalListPrice)}
        </div>
      )}
      {/* VERIFY-IDX §5.8(c): the listing's source sits right beside it. */}
      {mlsID && <div class="text-xs text-stone-500 mt-1">Source: NorthstarMLS · MLS #{mlsID}</div>}
    </div>
  </div>

  {/* ── Key stats bar ── */}
  <div class="flex flex-wrap gap-6 mt-6 text-sm text-stone-700">
    {isPositive(listing.beds) && (
      <div>
        <span class="font-semibold text-stone-900">{listing.beds}</span>{" "}
        {pluralize(listing.beds, "Bed")}
      </div>
    )}
    {bathTotal(listing) > 0 && (
      <div>
        <span class="font-semibold text-stone-900">{bathDisplay}</span>{" "}
        {pluralize(bathTotal(listing), "Bath")}
      </div>
    )}
    {isPositive(listing.sqftTotal) && (
      <div>
        <span class="font-semibold text-stone-900">{sqftDisplay}</span> Sqft
      </div>
    )}
    {isPositive(listing.lotSqft) && (
      <div>
        <span class="font-semibold text-stone-900">{lotDisplay}</span> Lot
      </div>
    )}
    {levelsDisplay && (
      <div>
        <span class="font-semibold text-stone-900">{levelsDisplay}</span>
      </div>
    )}
    {isPositive(listing.yearBuilt) && (
      <div>
        Built <span class="font-semibold text-stone-900">{listing.yearBuilt}</span>
      </div>
    )}
    {isPositive(listing.garageStalls) && (
      <div>
        <span class="font-semibold text-stone-900">{listing.garageStalls}</span> Car Garage
      </div>
    )}
    {listing.daysOnMarket != null && (
      <div>
        <span class="font-semibold text-stone-900">{listing.daysOnMarket}</span>{" "}
        {pluralize(listing.daysOnMarket, "Day")} on Market
      </div>
    )}
  </div>

  {/* ── Share ── */}
  <div class="mt-5">
    <ShareButtons
      url={absoluteUrl(listingPath(listing))}
      title={`${displayAddress(listing)}${listing.city ? `, ${listing.city}` : ""}`}
      text={shareSummary}
      image={shareImage}
      contentType="listing"
      itemId={mlsNumber(listing) ?? String(listing.id)}
    />
  </div>
</div>
