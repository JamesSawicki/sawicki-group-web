---
/**
 * "Close to Home": what's a short trip from the listing — groceries, food, parks,
 * pharmacies, hardware, and (on foot) transit. Phones (and listings scored before route
 * data) get one compact list with a Walk / Bike / Drive switch: each row shows the closest
 * place and how many are within 5 / 10 / 15 minutes. Desktop (lg+) gets the time strip
 * (CloseToHomeTimeStrip.astro). Renders nothing when the listing has no amenity scores yet.
 *
 * Scores come with the listing from the API's amenity pipeline (Mapbox isochrones +
 * OpenStreetMap, plus stores and restaurants OSM lacks from Overture Maps). Reachability
 * uses real street/path networks; the distance shown is straight-line. The mode switch
 * is CSS-only (radio inputs + :has), so no JavaScript.
 */
// ─── Imports ─────────────────────────────────────────────────────────────────
import type { Listing } from "../../types/listing";
import { categoryLabel, formatDistance, parseAmenityScores } from "../../lib/listing-utils";
import CloseToHomeTimeStrip from "./CloseToHomeTimeStrip.astro";

// ─── Props ───────────────────────────────────────────────────────────────────
interface Props {
  /** The listing being displayed; only `amenityScores` (JSON) is read. */
  listing: Listing;
}

const { listing } = Astro.props;

// ─── Derived values ──────────────────────────────────────────────────────────
const amenityScores = parseAmenityScores(listing.amenityScores);

const CATEGORIES = ["grocery", "restaurants", "parks", "pharmacy", "hardware"];
/** Scored for walking only (biking or driving to a bus stop isn't meaningful). */
const WALK_ONLY_CATEGORIES = ["transit_stations", "bus_stops"];
const BANDS = [5, 10, 15] as const;

// Class names must appear in full for Tailwind to generate them, hence the literals.
const MODES = [
  { key: "walk", label: "Walk", panelClass: "group-has-[#cth-walk:checked]/cth:block" },
  { key: "bike", label: "Bike", panelClass: "group-has-[#cth-bike:checked]/cth:block" },
  { key: "drive", label: "Drive", panelClass: "group-has-[#cth-drive:checked]/cth:block" },
] as const;

const panels = amenityScores
  ? MODES.map((mode) => {
      const categories =
        mode.key === "walk" ? [...CATEGORIES, ...WALK_ONLY_CATEGORIES] : CATEGORIES;
      const rows = categories.map((key) => {
        const cells = BANDS.map((min) => amenityScores.scores[`${mode.key}_${min}min`]?.[key]);
        // "Closest" comes from the smallest band that has the category.
        const closest = cells.find((c) => c);
        const named = closest?.nearestName && closest.nearestName !== "Unnamed";
        return {
          label: categoryLabel(key),
          counts: cells.map((c) => c?.count ?? 0),
          closest: closest
            ? `${named ? `${closest.nearestName} · ` : ""}${formatDistance(closest.nearestMeters)}`
            : `None within 15 min`,
        };
      });
      return { ...mode, rows };
    })
  : [];

// The desktop time strip needs the route-based `nearest` lists (scores v3+); without them
// desktop shows the list view too.
const hasStrip = !!amenityScores?.nearest;
const listOnly = hasStrip ? "lg:hidden" : "";

const updated = amenityScores
  ? new Date(amenityScores.generatedAt).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : "";
---

{amenityScores && (
  <section class="group/cth">
    <div class="flex flex-wrap items-end justify-between gap-3 mb-4">
      <div>
        <h2 class="text-2xl font-semibold">Close to Home</h2>
        <p class="text-sm text-stone-500">What's a short trip away, on real streets and paths.</p>
      </div>

      {/* ── Mode switch ── */}
      <div
        class={`inline-flex rounded-lg bg-stone-100 p-1 ${listOnly}`}
        role="radiogroup"
        aria-label="Travel mode"
      >
        {MODES.map((mode, i) => (
          <label class="cursor-pointer">
            <input
              type="radio"
              name="cth-mode"
              id={`cth-${mode.key}`}
              value={mode.key}
              checked={i === 0}
              class="peer sr-only"
            />
            <span
              class="inline-flex items-center min-h-11 px-4 rounded-md text-sm text-stone-600
                  peer-checked:bg-white peer-checked:text-stone-900 peer-checked:shadow-sm
                  peer-focus-visible:ring-2 peer-focus-visible:ring-stone-400"
            >
              {mode.label}
            </span>
          </label>
        ))}
      </div>
    </div>

    {/* ── Desktop: time strip ── */}
    {amenityScores && hasStrip && (
      <div class="hidden lg:block">
        <CloseToHomeTimeStrip
          scores={amenityScores}
          categories={CATEGORIES}
          walkOnlyCategories={WALK_ONLY_CATEGORIES}
        />
        <p class="text-xs text-stone-500 mt-3">
          Each icon sits at the minutes from this home to the nearest one, on real streets and
          paths; pick one for the three nearest. Transit: walking only.
        </p>
      </div>
    )}

    {/* ── One list per mode; the checked radio shows its list ── */}
    {/* The wrapper carries lg:hidden: on a panel it would lose to the :has() "show" rule. */}
    <div class={listOnly}>
      {panels.map((panel) => (
        <div class={`hidden ${panel.panelClass}`}>
          <div class="flex justify-end gap-1 pb-1 text-xs text-stone-500" aria-hidden="true">
            {BANDS.map((min) => (
              <span class="w-12 text-center">{min} min</span>
            ))}
          </div>
          <ul class="divide-y divide-stone-100 border-y border-stone-100">
            {panel.rows.map((row) => (
              <li class="flex items-center gap-3 py-2.5">
                <div class="min-w-0 flex-1 sm:flex sm:items-baseline sm:gap-3">
                  <div class="text-sm font-medium text-stone-900 sm:w-28 sm:shrink-0">
                    {row.label}
                  </div>
                  <div class="text-xs sm:text-sm text-stone-500 truncate">{row.closest}</div>
                </div>
                <div class="flex gap-1 text-sm tabular-nums">
                  {row.counts.map((n, i) => (
                    <span
                      class={`w-12 text-center ${n ? "text-stone-900" : "text-stone-300"}`}
                      aria-label={`${n} within ${BANDS[i]} minutes`}
                    >
                      {n || "–"}
                    </span>
                  ))}
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <p class={`text-xs text-stone-500 mt-3 ${listOnly}`}>
      Counts: places reachable within 5, 10 and 15 minutes. Distance: straight-line to the closest
      one.
    </p>
    <p class="text-xs text-stone-500 mt-1">
      Data via Mapbox, © OpenStreetMap contributors and Overture Maps Foundation; updated {updated}.
    </p>
  </section>
)}
